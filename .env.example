# ── CompCare Hub — Environment Variables ──────────────────────────────────
# Copy this to .env and fill in your real values.
# NEVER commit .env to git.
# --------------------------------------------------------------------------

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# Domain (used for CORS whitelist)
ALLOWED_ORIGINS=https://compcarehub.co.uk,https://www.compcarehub.co.uk

# ── Database (Aiven PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:port/dbname?ssl=true&sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string

# ── AI APIs ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=placeholder

# ── File uploads (leave blank to use local /app/backend/uploads volume) ───
# UPLOAD_DIR=/app/backend/uploads
