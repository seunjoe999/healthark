NODE_ENV=development
PORT=3001

# ── PostgreSQL ────────────────────────────────────────────────────
# On Windows, DB_USER is usually "postgres" and DB_PASSWORD is what
# you typed when you installed PostgreSQL (the installer asked for it).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthark
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
DB_SSL=false

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=healthark-super-secret-jwt-key-minimum-64-characters-long-aabbccdd
JWT_REFRESH_SECRET=healthark-refresh-secret-different-from-above-aabbccddeeffgg
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Email (Gmail SMTP) ────────────────────────────────────────────
# For Gmail: use your Gmail address and an App Password
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Optional ──────────────────────────────────────────────────────
LOG_LEVEL=info
FROM_EMAIL=noreply@comprehensivecare.org.uk
FROM_NAME=CompCare Hub
ANTHROPIC_API_KEY=placeholder
